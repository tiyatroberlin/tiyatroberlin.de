---
permalink: "/yorum/index.html"
layout: bare.njk
title: Ne kaldı aklında?
eleventyExcludeFromCollections: true
---
{%- set plays = [["kozalar","Kozalar"],["80lerde-lubunya-olmak","80'lerde Lubunya Olmak"],["yakin","YAKIN"]] -%}
<section class="section yorum"><div class="wrap">
  <h1 class="h-huge">Ne kaldı aklında<span class="pt">?</span></h1>
  <p class="yorum-sub">Oyun üzerine iki cümle.<span class="de" lang="de">Zwei Sätze zum Stück.</span></p>

  <form class="cform yform" id="yform" action="https://api.web3forms.com/submit" method="post" novalidate data-w3="{{ site.web3forms_key }}">
    <label>Oyun<span class="de" lang="de">Stück</span>
      <select name="oyun" id="y-oyun" required>
        <option value="">Seç · Auswählen</option>
        {%- for p in plays %}<option value="{{ p[0] }}">{{ p[1] }}</option>{% endfor %}
      </select></label>
    <label>Yorumun<span class="de" lang="de">Dein Kommentar</span>
      <textarea name="yorum" rows="6" required></textarea></label>
    <label><span>Adın ya da baş harflerin <span class="opt">isteğe bağlı</span></span><span class="de" lang="de">Name oder Initialen <span class="opt">optional</span></span>
      <input type="text" name="ad" autocomplete="name"></label>
    <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <fieldset class="src">
      <legend>Bizi nereden duydun? <span class="opt">isteğe bağlı</span><span class="de" lang="de">Wie hast du von uns erfahren? <span class="opt">optional</span></span></legend>
      <div class="src-list">
        <label class="src-opt"><input type="radio" name="kaynak" value="Sosyal medya"> <span>Sosyal medya<span class="de" lang="de">Soziale Medien</span></span></label>
        <label class="src-opt"><input type="radio" name="kaynak" value="Arkadaş ya da tanıdık"> <span>Arkadaş ya da tanıdık<span class="de" lang="de">Freunde, Bekannte</span></span></label>
        <label class="src-opt"><input type="radio" name="kaynak" value="Etkinlik programı"> <span>Etkinlik programı<span class="de" lang="de">Veranstaltungskalender</span></span></label>
        <label class="src-opt"><input type="radio" name="kaynak" value="Afiş ya da el ilanı"> <span>Afiş ya da el ilanı<span class="de" lang="de">Plakat oder Flyer</span></span></label>
        <label class="src-opt"><input type="radio" name="kaynak" value="Bülten"> <span>Bülten<span class="de" lang="de">Newsletter</span></span></label>
        <label class="src-opt"><input type="radio" name="kaynak" value="Mekânın kendi duyurusu"> <span>Mekânın kendi duyurusu<span class="de" lang="de">Über den Spielort</span></span></label>
        <label class="src-opt"><input type="radio" name="kaynak" value="Diğer" data-other> <span>Diğer<span class="de" lang="de">Sonstiges</span></span></label>
      </div>
      <label class="src-other" hidden><span class="visually-hidden">Diğer · Sonstiges</span><input type="text" name="kaynak_diger" placeholder="Nereden? · Woher?" maxlength="120"></label>
    </fieldset>
    <label class="consent"><input type="checkbox" name="onay" value="evet"> <span>Yorumumun Tiyatro Berlin'in sitesinde ve sosyal medyasında, adımla ya da baş harflerimle kullanılmasına izin veriyorum.<span class="de" lang="de">Ich bin einverstanden, dass mein Kommentar auf der Website und in den sozialen Medien von Tiyatro Berlin verwendet wird.</span></span></label>
    <p><button class="btn red" type="submit">Gönder · <span lang="de">Senden</span></button></p>
    <p class="cform-msg" role="status" aria-live="polite"></p>
  </form>
  <div class="yorum-ok" id="yorum-ok" hidden tabindex="-1">
    <p class="yorum-thanks">Teşekkürler<span class="pt">.</span> Bir sonraki perdede görüşmek üzere.</p>
    <p class="yorum-thanks de" lang="de">Danke. Bis zum nächsten Vorhang.</p>
  </div>
</div></section>
<script>
(()=>{const f=document.getElementById('yform'),sel=document.getElementById('y-oyun');
const names={ {%- for p in plays %}"{{ p[0] }}":{{ p[1] | dump | safe }}{% if not loop.last %},{% endif %}{% endfor -%} };
const q=new URLSearchParams(location.search).get('oyun');if(q&&names[q.toLowerCase()])sel.value=q.toLowerCase();
const m=f.querySelector('.cform-msg'),b=f.querySelector('button'),bt=b.innerHTML;
const oth=f.querySelector('.src-other');
f.querySelectorAll('input[name=kaynak]').forEach(r=>r.addEventListener('change',()=>{const on=f.querySelector('input[name=kaynak][data-other]').checked;oth.hidden=!on;if(on)oth.querySelector('input').focus();}));
const src=()=>{const r=f.querySelector('input[name=kaynak]:checked');if(!r)return '(boş)';if(r.hasAttribute('data-other')){const t=f.kaynak_diger.value.trim();return t?'Diğer: '+t:'Diğer';}return r.value;};
const done=()=>{f.hidden=true;const ok=document.getElementById('yorum-ok');ok.hidden=false;ok.focus();ok.scrollIntoView({block:'center'});};
if(new URLSearchParams(location.search).get('tesekkur'))done();
f.addEventListener('submit',async e=>{e.preventDefault();if(!f.reportValidity())return;if(f._honey.value)return;
const oyun=names[sel.value];
const d={access_key:f.dataset.w3,subject:'Seyirci yorumu · '+oyun,from_name:'tiyatroberlin.de/yorum',botcheck:'',
'Oyun':oyun,'Yorum':f.yorum.value.trim(),'Ad':f.ad.value.trim()||'(yok)','Nereden duydu':src(),'Onay':f.onay.checked?'evet':'hayır'};
b.disabled=true;b.textContent='…';m.textContent='';m.className='cform-msg';
const fd=new FormData();Object.entries(d).forEach(([k,v])=>fd.append(k,v));
try{const r=await fetch(f.action,{method:'POST',headers:{Accept:'application/json'},body:fd});const j=await r.json().catch(()=>({}));
if(!(r.ok&&String(j.success)!=='false'))throw 0;done();}
catch(_){
  /* yedek: tarayıcının olağan form gönderimi, sonra teşekkür sayfasına dönüş */
  const nf=document.createElement('form');nf.method='post';nf.action=f.action;nf.hidden=true;
  d.redirect=location.origin+location.pathname+'?tesekkur=1&oyun='+encodeURIComponent(sel.value);
  Object.entries(d).forEach(([k,v])=>{const i=document.createElement('input');i.type='hidden';i.name=k;i.value=v;nf.appendChild(i);});
  document.body.appendChild(nf);nf.submit();
}
});})();
</script>
