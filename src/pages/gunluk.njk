<meta name="robots" content="noindex,nofollow"><title>Ders Defteri · Tiyatro Berlin</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600;700;800&family=DejaVu+Sans+Mono&display=swap" rel="stylesheet"><style>
*{box-sizing:border-box}
:root{--red:#e32b2b;--ink:#161616;--muted:#6b6b76;--line:#dcdce0;--tint:#f6f6f7}
body{font-family:"Inter",system-ui,sans-serif;color:var(--ink);background:#f4f4f6;margin:0;line-height:1.5}
.wrap{max-width:172mm;margin:0 auto;background:#fff;padding:9mm 9mm 14mm;box-shadow:0 1px 20px rgba(0,0,0,.08)}
.gk{font-family:"Inter";font-weight:800;letter-spacing:.14em;text-transform:uppercase;font-size:8pt;color:var(--red)}
h1{font-family:"Lora",serif;font-weight:700;font-size:23pt;margin:1mm 0 3mm}
.tabs{display:flex;gap:1.5mm;border-bottom:2px solid var(--line);margin-bottom:5mm;flex-wrap:wrap}
.tab{font:inherit;font-weight:700;font-size:10pt;color:var(--muted);background:none;border:0;border-bottom:3px solid transparent;padding:2.5mm 3mm;margin-bottom:-2px;cursor:pointer}
.tab.on{color:var(--red);border-bottom-color:var(--red)}
.view{animation:fade .15s}
@keyframes fade{from{opacity:.3}to{opacity:1}}
label{display:block;font-weight:600;font-size:9.5pt;margin:0 0 1.5mm}
input[type=text],input[type=date],select,textarea{width:100%;font:inherit;font-size:10.5pt;padding:2.6mm 3mm;border:1.5px solid var(--line);border-radius:2mm;background:#fff}
textarea{resize:vertical;min-height:22mm}
.row{display:flex;gap:4mm;flex-wrap:wrap;margin:0 0 4mm}.row>div{flex:1;min-width:40mm}
.sec{margin:6mm 0 2mm;font-family:"Inter";font-weight:800;font-size:9pt;text-transform:uppercase;letter-spacing:.05em;color:var(--red);border-bottom:1px solid var(--line);padding-bottom:1.5mm}
.hint{font-size:8.5pt;color:var(--muted);margin:.5mm 0 2.5mm}
#clist,#gelmeyen-wrap .cks{display:flex;flex-direction:column;gap:1.5mm;margin:2mm 0}
.ci{display:flex;align-items:flex-start;gap:2.5mm;padding:2.2mm 3mm;border:1px solid var(--line);border-radius:2mm;background:var(--tint);cursor:pointer}
.ci input{margin-top:.6mm;width:4.5mm;height:4.5mm;flex:none;accent-color:var(--red)}
.ci span{font-size:9.6pt}
.btn{font-family:"Inter";font-weight:700;font-size:11pt;color:#fff;background:var(--red);border:0;border-radius:2mm;padding:3.2mm 8mm;cursor:pointer;margin-top:4mm}
.btn:disabled{opacity:.5}
.btn2{font:inherit;font-weight:700;font-size:9.5pt;color:#fff;background:var(--red);border:0;border-radius:2mm;padding:2.6mm 5mm;cursor:pointer;flex:none}
.msg{font-size:9.5pt;margin-top:3mm;min-height:1.2em}.msg.ok{color:#1a7a3a}.msg.err{color:#c0392b}
/* geçmiş */
.ozet{background:var(--tint);border-radius:2mm;padding:3mm 3.5mm;font-size:9.3pt;margin-bottom:4mm}
.ozet b{color:var(--red)}
.entry{border:1px solid var(--line);border-left:4px solid var(--red);border-radius:2mm;padding:3mm 3.5mm;margin-bottom:3mm}
.entry .eh{display:flex;gap:2mm;align-items:baseline;flex-wrap:wrap;margin-bottom:1.5mm}
.entry .en{font-family:"Lora",serif;font-weight:700;font-size:12pt}
.entry .ed{font-size:8.3pt;color:var(--muted)}
.entry .lbl{font-weight:800;font-size:7.3pt;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin:1.5mm 0 .5mm}
.entry ul{margin:.3mm 0;padding-left:5mm}.entry li{font-size:9.2pt;margin:.3mm 0}
.entry p{margin:0;font-size:9.4pt}
/* ödeme */
.ogr{display:flex;flex-wrap:wrap;gap:1.5mm;margin:2mm 0 2mm}
.ogrchip{display:inline-flex;align-items:center;gap:1.5mm;background:var(--tint);border:1px solid var(--line);border-radius:20mm;padding:1.3mm 1.3mm 1.3mm 3mm;font-size:9pt}
.ogrchip button{border:0;background:#ddd;color:#333;border-radius:50%;width:5mm;height:5mm;line-height:1;cursor:pointer;font-size:9pt}
.gridscroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
table.grid{border-collapse:collapse;font-size:9pt;min-width:100%}
table.grid th,table.grid td{border:1px solid var(--line);padding:2mm 2.5mm;text-align:center;white-space:nowrap}
table.grid th{background:var(--red);color:#fff;font-size:8pt;text-transform:uppercase;letter-spacing:.03em;position:sticky;top:0}
table.grid td.nm{text-align:left;font-weight:600;position:sticky;left:0;background:#fff}
table.grid td.paid{background:#e7f6ec}
table.grid td.unpaid{background:#fdecec}
table.grid tr.tot td{font-weight:700;background:var(--tint)}
.subtabs{display:flex;gap:1.5mm;margin-bottom:4mm;flex-wrap:wrap}
.subtab{font:inherit;font-weight:600;font-size:9pt;color:var(--muted);background:var(--tint);border:1px solid var(--line);border-radius:20mm;padding:1.6mm 4mm;cursor:pointer}
.subtab.on{color:#fff;background:var(--red);border-color:var(--red)}
.dossier{border:1px solid var(--line);border-left:4px solid var(--red);border-radius:2mm;padding:3mm 3.5mm;margin-top:3mm}
.dossier .big{font-family:"Lora",serif;font-weight:700;font-size:14pt;margin-bottom:1mm}
.dossier .lbl{font-weight:800;font-size:7.3pt;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin:2.5mm 0 .8mm}
.dossier p{margin:0;font-size:9.6pt}.dossier ul{margin:.5mm 0;padding-left:5mm}.dossier li{font-size:9.2pt;margin:.3mm 0}
.pill{display:inline-block;background:var(--tint);border:1px solid var(--line);border-radius:20mm;padding:.8mm 2.5mm;font-size:8.5pt;margin:.6mm .6mm 0 0}
.pill.on{background:#e7f6ec;border-color:#bfe6cd;color:#1a7a3a;font-weight:600}
table.grid input{width:5mm;height:5mm;accent-color:#1a7a3a;cursor:pointer}
.summ{font-size:9pt;margin-top:3mm}.summ .bad{color:var(--red);font-weight:700}
.hp{position:absolute;left:-9999px}
#gate{position:fixed;inset:0;background:linear-gradient(150deg,#e32b2b,#6D3BE4 55%,#2563EB);display:flex;align-items:center;justify-content:center;z-index:100;padding:6mm}
.gatebox{background:#fff;border-radius:4mm;padding:9mm 8mm;max-width:92mm;width:100%;text-align:center;box-shadow:0 10px 40px rgba(0,0,0,.3)}
.gatebox .gk2{font-family:"Inter";font-weight:800;letter-spacing:.14em;text-transform:uppercase;font-size:7.5pt;color:var(--red)}
.gatebox h2{font-family:"Lora",serif;font-weight:700;font-size:17pt;margin:2mm 0 1mm}
.gatebox p{font-size:8.5pt;color:var(--muted);margin:0 0 5mm}
.gatebox input{margin-bottom:3mm}
.gatebox button{width:100%;font-weight:700;font-size:11pt;color:#fff;background:var(--red);border:0;border-radius:2mm;padding:3.2mm;cursor:pointer}
#gerr{color:#c0392b;font-size:8.5pt;min-height:1.2em;margin:3mm 0 0}
@media(max-width:620px){.wrap{padding:6mm 5mm 12mm}}
</style></head><body>
