 if(!confirm('20 deneme kişi (Kişi 1–20) eklensin mi? Sonra tek tek silip gerçek isimleri koyabilirsin.'))return;
 var b=this;b.disabled=true;b.textContent='Ekleniyor…';var i=1;
 function step(){if(i>20){load(true).then(function(){renderOdeme();renderGelmeyen();}).finally(function(){b.disabled=false;b.textContent='20 deneme kişi';});return;}
  api({action:'addOgrenci',ad:'Kişi '+i}).then(function(){i++;step();}).catch(function(){i++;step();});}
 step();
});

function delOgr(name){if(!confirm(name+' silinsin mi?'))return;
 api({action:'delOgrenci',ad:name}).then(function(){return load(true)}).then(function(){renderOdeme();renderGelmeyen();})
 .catch(function(err){alert('Silinemedi: '+err.message)});
}
function setOd(name,ay,on,td){td.className=on?'paid':'unpaid';STATE.odeme[name+'||'+ay]=on?1:0;
 api({action:'setOdeme',ogrenci:name,ay:ay,durum:on?1:0}).catch(function(){td.className=on?'unpaid':'paid';alert('Kaydedilemedi, tekrar deneyin.');var cb=td.querySelector('input');if(cb)cb.checked=!on;STATE.odeme[name+'||'+ay]=on?0:1;});
}
function renderOdeme(){
 var ul=document.getElementById('ogr-list');
 if(!STATE.ogrenciler.length){ul.innerHTML='<div class="hint">Henüz öğrenci yok.</div>';}
 else{ul.innerHTML=STATE.ogrenciler.map(function(n){return '<span class="ogrchip">'+esc(n)+' <button type="button" title="sil" data-del="'+esc(n)+'">×</button></span>'}).join('');
  ul.querySelectorAll('[data-del]').forEach(function(b){b.addEventListener('click',function(){delOgr(b.getAttribute('data-del'))})});}
 var wrap=document.getElementById('odeme-wrap'),summ=document.getElementById('odeme-summ');
 if(!STATE.ogrenciler.length){wrap.innerHTML='<div class="hint">Öğrenci ekleyince ödeme tablosu burada çıkar.</div>';summ.innerHTML='';return;}
 var M=STATE.months;
 var h='<div class="gridscroll"><table class="grid"><thead><tr><th class="nm">Öğrenci</th>';
 M.forEach(function(m){h+='<th>'+esc(m)+'</th>'});h+='</tr></thead><tbody>';
 STATE.ogrenciler.forEach(function(n){h+='<tr><td class="nm">'+esc(n)+'</td>';
  M.forEach(function(m){var paid=STATE.odeme[n+'||'+m]===1;h+='<td class="'+(paid?'paid':'unpaid')+'" data-n="'+esc(n)+'" data-m="'+esc(m)+'"><input type="checkbox" '+(paid?'checked':'')+'></td>'});
  h+='</tr>';});
 h+='</tbody></table></div>';wrap.innerHTML=h;
 wrap.querySelectorAll('td[data-n]').forEach(function(td){var cb=td.querySelector('input');
  cb.addEventListener('change',function(){setOd(td.getAttribute('data-n'),td.getAttribute('data-m'),cb.checked,td)})});
 // bu ayın ödemeyenleri
 var now=new Date(),mi=now.getMonth();var curName={10:'Kasım',11:'Aralık',0:'Ocak',1:'Şubat',2:'Mart',3:'Nisan',4:'Mayıs'}[mi];
 if(curName&&M.indexOf(curName)>=0){var bad=STATE.ogrenciler.filter(function(n){return STATE.odeme[n+'||'+curName]!==1});
  summ.innerHTML=curName+' ödemeyenler: '+(bad.length?'<span class="bad">'+bad.map(esc).join(', ')+'</span>':'<b>yok, herkes ödedi</b>');}
 else summ.innerHTML='';
}

/* --- öğrenci dosyası --- */
function renderOgrenciTab(){var s=document.getElementById('ogr-sec'),cur=s.value;
 s.innerHTML='<option value="">— öğrenci seçin —</option>'+STATE.ogrenciler.map(function(n){return '<option'+(n===cur?' selected':'')+'>'+esc(n)+'</option>'}).join('');
 if(!STATE.ogrenciler.length){document.getElementById('ogr-detay').innerHTML='<div class="hint">Henüz öğrenci yok. Ödemeler sekmesinden ekleyin.</div>';return;}
 renderOgrenciDetay(s.value);
}
function renderOgrenciDetay(name){var d=document.getElementById('ogr-detay');if(!name){d.innerHTML='';return;}
 var M=STATE.months||[];
 var paidM=M.filter(function(m){return STATE.odeme[name+'||'+m]===1});
 var missed=(STATE.gunluk||[]).filter(function(r){return String(r.gelmeyenler||'').split(',').map(function(x){return x.trim()}).indexOf(name)>=0})
   .sort(function(a,b){return new Date(b.zaman)-new Date(a.zaman)});
 var h='<div class="dossier"><div class="big">'+esc(name)+'</div>';
 h+='<div class="lbl">Ödemeler</div><p>Ödenen ay: <b>'+paidM.length+'</b> · Toplam: <b>'+money(paidM.length*FEE)+'</b></p>';
 h+='<div>'+M.map(function(m){var on=STATE.odeme[name+'||'+m]===1;return '<span class="pill'+(on?' on':'')+'">'+esc(m)+(on?' ✓':'')+'</span>'}).join('')+'</div>';
 h+='<div class="lbl">Devamsızlık</div>';
 if(missed.length){h+='<p>Gelmediği ders: <b>'+missed.length+'</b></p><ul>'+missed.map(function(r){return '<li>'+esc(r.gun||'')+' · '+esc(r.tarih||'')+'</li>'}).join('')+'</ul>';}
 else{h+='<p>Kayda göre gelmediği ders yok.</p>';}
 d.innerHTML=h+'</div>';
}
document.getElementById('ogr-sec').addEventListener('change',function(){renderOgrenciDetay(this.value)});

/* --- yükle --- */
function render(){renderGelmeyen();}
function load(silent){if(!silent){document.getElementById('loadmsg').textContent='Yükleniyor…';}
 return api({action:'get'}).then(function(d){if(!d||!d.ok)throw new Error((d&&d.error)||'veri alinamadi');
   STATE=d; if(!STATE.months)STATE.months=["Kasım","Aralık","Ocak","Şubat","Mart","Nisan","Mayıs"];
   document.getElementById('loadmsg').textContent='';render();})
 .catch(function(err){document.getElementById('loadmsg').innerHTML='Veriye ulaşılamadı ('+esc(err.message)+'). <a href="#" id="retry">Tekrar dene</a>';
   var r=document.getElementById('retry');if(r)r.addEventListener('click',function(e){e.preventDefault();load();});});
}

renderGelmeyen();

/* --- şifre kapısı --- */
(function(){var U="tiyatroberlin",P="kurs",K="tb_ok";
 function unlock(){var g=document.getElementById('gate');if(g)g.style.display='none';try{sessionStorage.setItem(K,'1')}catch(e){}load();}
 try{if(sessionStorage.getItem(K)==='1'){unlock();return;}}catch(e){}
 var gf=document.getElementById('gf2');gf.addEventListener('submit',function(e){e.preventDefault();
  var u=document.getElementById('gu').value.trim().toLowerCase().replace(/\s+/g,''),p=document.getElementById('gp').value;
  if(u===U&&p===P){unlock()}else{document.getElementById('gerr').textContent='Kullanıcı adı veya şifre hatalı.'}});
})();
</script>
