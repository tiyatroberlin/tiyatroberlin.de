var STATE={months:["Kasım","Aralık","Ocak","Şubat","Mart","Nisan","Mayıs"],ogrenciler:[],gunluk:[],odeme:{}};
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function api(params){return new Promise(function(res,rej){
 var cb='cb'+Date.now()+Math.floor(Math.random()*1e6);
 var s=document.createElement('script');
 var t=setTimeout(function(){done();rej(new Error('zaman asimi'))},25000);
 function done(){try{delete window[cb]}catch(e){}if(s&&s.parentNode)s.parentNode.removeChild(s);clearTimeout(t);}
 window[cb]=function(d){done();res(d)};
 var q='callback='+cb+'&token='+encodeURIComponent(TOKEN);
 for(var k in params)q+='&'+encodeURIComponent(k)+'='+encodeURIComponent(params[k]);
 s.src=API+'?'+q; s.onerror=function(){done();rej(new Error('ag hatasi'))};
 document.body.appendChild(s);
});}

