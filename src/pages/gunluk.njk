document.getElementById('ogr-ekle').addEventListener('click',function(){
 var inp=document.getElementById('ogr-ad'),name=inp.value.trim();if(!name)return;
 this.disabled=true;
 api({action:'addOgrenci',ad:name}).then(function(){inp.value='';return load(true)}).then(function(){renderOdeme();renderGelmeyen();})
 .catch(function(err){alert('Eklenemedi: '+err.message)})
 .finally(function(){document.getElementById('ogr-ekle').disabled=false});
});
document.getElementById('ogr-ad').addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();document.getElementById('ogr-ekle').click();}});
