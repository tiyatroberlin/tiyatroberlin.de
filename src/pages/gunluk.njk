 if(any)return [].slice.call(document.querySelectorAll('[data-gel]:checked')).map(function(c){return c.value}).join(', ');
 var ta=document.querySelector('[name=gelmeyenler]');return ta?ta.value:'';}

/* --- günlük gönder --- */
var f=document.getElementById('gf'),msg=document.getElementById('msg'),btn=f.querySelector('button.btn');
f.addEventListener('submit',function(e){e.preventDefault();if(f._honey.value)return;if(!f.reportValidity())return;
 var done=[].slice.call(clist.querySelectorAll('input[data-ex]:checked')).map(function(c){return c.value});
 var gn=sel.value;
 btn.disabled=true;btn.textContent='Kaydediliyor…';msg.textContent='';msg.className='msg';
 api({action:'addGunluk',tarih:f.tarih.value,gun:gn+'. Gün',egitmen:f.egitmen.value,
   calismalar:done.join(' | '),ek:f.ek.value,notlar:f.notlar.value,gelmeyenler:gelmeyenText()})
 .then(function(d){if(!d||!d.ok)throw new Error((d&&d.error)||'kayit olmadi');
   msg.textContent='Kaydedildi — Veri tabanı sekmesine düştü.';msg.className='msg ok';
   f.reset();clist.innerHTML='<div class="hint">Önce yukarıdan bir gün seçin.</div>';hint.textContent='';renderGelmeyen();
   return load(true);})
 .catch(function(err){msg.textContent='Kaydedilemedi ('+err.message+'). Tekrar deneyin.';msg.className='msg err';})
 .finally(function(){btn.disabled=false;btn.textContent='Gönder';});
});

/* --- geçmiş --- */
var FEE=80;
function money(n){return Math.round(n).toLocaleString('tr-TR')+' €';}
function renderGecmis(){
 var ozet=document.getElementById('gecmis-ozet'),list=document.getElementById('gecmis-list');
 var M=STATE.months||[];
 /* --- ödeme raporu: ay ay --- */
 var tR=0,prows='';
 M.forEach(function(m){var c=STATE.ogrenciler.filter(function(n){return STATE.odeme[n+'||'+m]===1}).length;var t=c*FEE;tR+=t;
  prows+='<tr><td class="nm">'+esc(m)+'</td><td>'+c+'</td><td>'+money(t)+'</td><td>'+money(t/2)+'</td><td>'+money(t*0.25)+'</td><td>'+money(t*0.25)+'</td></tr>';});
 var rep='<div class="sec" style="margin-top:0">Ödeme raporu · ay ay</div>'
  +'<div class="hint">Ücret 80 €/ay · Kira: toplamın yarısı · Ufuk %25 · Hazal %25. Ödemeler sekmesinde işaretledikçe burası güncellenir.</div>'
  +'<div class="gridscroll"><table class="grid"><thead><tr><th class="nm">Ay</th><th>Ödeyen</th><th>Toplam</th><th>Kira</th><th>Ufuk</th><th>Hazal</th></tr></thead><tbody>'
  +prows
  +'<tr class="tot"><td class="nm">GENEL TOPLAM</td><td>—</td><td>'+money(tR)+'</td><td>'+money(tR/2)+'</td><td>'+money(tR*0.25)+'</td><td>'+money(tR*0.25)+'</td></tr>'
  +'</tbody></table></div>';
 var rap=document.getElementById('rapor');if(rap)rap.innerHTML=rep;
 /* --- ders kayıtları --- */
 var rows=(STATE.gunluk||[]).slice().sort(function(a,b){return new Date(b.zaman)-new Date(a.zaman)});
 var days={};rows.forEach(function(r){days[r.gun]=1});
 if(!rows.length){ozet.innerHTML='<div class="hint">Henüz ders kaydı yok. İlk dersten sonra Günlük sekmesinden doldurun.</div>';list.innerHTML='';return;}
 ozet.innerHTML='<div class="ozet">Toplam <b>'+rows.length+'</b> kayıt · <b>'+Object.keys(days).length+'</b> ayrı ders dolduruldu. En yeni en üstte.</div>';
 var h='';
 rows.forEach(function(r){
  h+='<div class="entry"><div class="eh"><span class="en">'+esc(r.gun||'')+'</span>'
    +'<span class="ed">'+esc(r.tarih||'')+(r.egitmen?' · '+esc(r.egitmen):'')+'</span></div>';
  var cal=String(r.calismalar||'').split(' | ').filter(String);
  if(cal.length){h+='<div class="lbl">Yapılan çalışmalar</div><ul>'+cal.map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ul>';}
  if(r.ek){h+='<div class="lbl">Ek</div><p>'+esc(r.ek)+'</p>';}
  if(r.notlar){h+='<div class="lbl">Notlar</div><p>'+esc(r.notlar)+'</p>';}
  if(r.gelmeyenler){h+='<div class="lbl">Gelmeyenler</div><p>'+esc(r.gelmeyenler)+'</p>';}
  h+='</div>';
 });
 list.innerHTML=h;
}

