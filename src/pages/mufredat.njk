<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Müfredat · Tiyatro Berlin</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600;700;800&family=DejaVu+Sans+Mono&display=swap" rel="stylesheet"><style>:root{--ink:#1b1b22;--muted:#6b6b76;--line:#dcdce4;--accent:#D11A45}
