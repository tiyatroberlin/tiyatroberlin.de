.block{margin-bottom:3.2mm} .cal{break-inside:avoid}
.bhead{display:flex;align-items:baseline;gap:2.5mm;background:var(--blok);padding:1.3mm 2.6mm;border-radius:1.8mm;margin-bottom:2mm}
