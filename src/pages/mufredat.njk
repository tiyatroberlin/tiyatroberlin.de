html{scroll-behavior:smooth}
body{background:#f4f4f6;margin:0}
.book{max-width:188mm;margin:0 auto;background:#fff;padding:9mm 10mm 16mm;box-shadow:0 1px 20px rgba(0,0,0,.08)}
