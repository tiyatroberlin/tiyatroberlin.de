---
pagination: {data: site.langs, size: 1, alias: lang}
permalink: "/{{ lang }}/"
layout: base.njk
eleventyComputed:
  alt: {tr: "/tr/", de: "/de/", en: "/en/"}
---
{%- import "macros.njk" as m -%}
{%- set L = i18n[lang] -%}
{%- set S = site.sections -%}
{%- set nxt = graph.program[0] -%}
{%- set nw = graph.workBySlug[nxt.work] if nxt and not nxt.external else null -%}
{% if nxt %}
<section class="lead">
  {% set heroImg = (nw.hero or nw.image) if nw else null %}{% if heroImg %}<figure class="lead-figure{% if nw.hero_fit %} fit{% endif %}"><img src="{{ ('/assets/img/' + heroImg) | url }}?v={{ build }}" alt="" width="1080" height="1240"></figure>{% endif %}
  <div class="wrap">
    <div class="lead-text">
      <p class="lead-when"><span class="dot" aria-hidden="true"></span>{{ L.next }}: {% if lang == "tr" %}{{ nxt.date | longDate(L, lang) }} {{ nxt.date | weekday(L) }}{% if nxt.time %}, {{ nxt.time }}{% endif %}{% elif lang == "de" %}{{ nxt.date | weekday(L) }}, {{ nxt.date | longDate(L, lang) }}{% if nxt.time %}, {{ nxt.time }} Uhr{% endif %}{% else %}{{ nxt.date | weekday(L) }} {{ nxt.date | longDate(L, lang) }}{% if nxt.time %}, {{ nxt.time }}{% endif %}{% endif %}</p>
      <h1 class="lead-title">{% if nw %}<a href="{{ ('/' + lang + '/' + S.works[lang] + '/' + nw.slug + '/') | url }}">{{ nxt.title }}<span class="pt">.</span></a>{% else %}{{ nxt.title }}<span class="pt">.</span>{% endif %}</h1>
      {% if nw and nw.quote %}<p class="lead-hook it">{{ nw.hook | t(lang) }}</p>{% endif %}
      <dl class="lead-meta">
        <dt>{{ L.where }}</dt><dd>{% set lv = graph.venues[nxt.venue] %}{% if lv.address %}<a class="vlink" href="{{ nxt.venue | venueHref(lang) }}">{{ lv.name }}</a>{% else %}{{ lv.name }}{% endif %}, {{ graph.venues[nxt.venue].district }}</dd>
        {% if nw %}<dt>{{ L.info }}</dt><dd>{{ nw.form | t(lang) }}</dd>{% endif %}
      </dl>
      {% if nxt.eventim %}<button class="btn" type="button" data-eventim="{{ nxt.eventim }}" data-account="{{ site.eventim_account }}" aria-expanded="false" aria-controls="t-lead">{{ L.tickets }}</button>
      {% elif nxt.ticket %}<a class="btn" href="{{ nxt.ticket }}" rel="noopener">{{ L.tickets }}</a>{% endif %}
      <a class="btn ghost" href="{{ ('/' + lang + '/' + S.program[lang] + '/') | url }}">{{ L.all_program }}</a>
      {% if nxt.eventim %}<div class="ticket" id="t-lead" hidden></div>{% endif %}
    </div>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="wrap">
    <div class="section-head"><h2>{{ L.nav.program }}<span class="pt">.</span></h2><a href="{{ ('/' + lang + '/' + S.program[lang] + '/') | url }}">{{ L.all_program }}</a></div>
    <ul class="shows">
      {%- for s in graph.program %}{% if loop.index <= 7 %}{{ m.showRow(s, lang, L, graph, site, loop.index) }}{% endif %}{% endfor %}
    </ul>
  </div>
</section>


{%- set fw = graph.workBySlug[site.home_feature] if site.home_feature else null %}
{%- if fw and fw.teaser and (fw.upcoming | length) %}
{%- set f1 = fw.upcoming[0] %}
{%- set fhref = ('/' + lang + '/' + S.works[lang] + '/' + fw.slug + '/') | url %}
<section class="section feature">
  <div class="wrap feature-grid">
    <figure class="teaser">
      <video class="teaser-video" src="{{ ('/assets/' + fw.teaser.video) | url }}" poster="{{ ('/assets/' + fw.teaser.poster) | url }}" autoplay muted loop playsinline preload="metadata" aria-label="{{ fw.title }}: {{ L.teaser }}" data-autoplay></video>
      <button class="snd" type="button" aria-pressed="false" data-on="{{ L.sound_on }}" data-off="{{ L.sound_off }}">{{ L.sound_on }}</button>
    </figure>
    <div class="feature-text">
      <p class="lead-when"><span class="dot" aria-hidden="true"></span>{% if f1.premiere %}{{ L.premiere if fw.premiere_kind == "premiere" else L.world_premiere }}{% else %}{{ L.next }}{% endif %}: {{ f1.date | longDate(L, lang) }}</p>
      <h2 class="feature-title"><a href="{{ fhref }}">{{ fw.title }}<span class="pt">.</span></a></h2>
      <p class="feature-hook it">{{ fw.hook | t(lang) }}</p>
      <p class="feature-form">{{ fw.form | t(lang) }}</p>
      <dl class="credits">
        {%- for c in fw.credits %}
        <div><dt>{{ graph.db.roles | roleName(c.role, lang) }}</dt><dd>{% for sl in c.people %}<a href="{{ ('/' + lang + '/' + S.people[lang] + '/' + sl + '/') | url }}">{{ graph.people[sl].name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd></div>
        {%- endfor %}
      </dl>
      <ul class="feature-dates">
        {%- for s in fw.upcoming %}
        <li><time datetime="{{ s.date }}">{{ s.date | dmyL(lang, L) }}{% if s.time %} · {{ s.time }}{% endif %}</time><span>{% set fv = graph.venues[s.venue] %}{% if fv.address %}<a class="vlink" href="{{ s.venue | venueHref(lang) }}">{{ fv.name }}</a>{% else %}{{ fv.name }}{% endif %}</span></li>
        {%- endfor %}
      </ul>
      <p class="feature-btns">{% if f1.eventim %}<button class="btn" type="button" data-eventim="{{ f1.eventim }}" data-account="{{ site.eventim_account }}" aria-expanded="false" aria-controls="t-feat">{{ L.tickets }}</button>{% elif f1.ticket %}<a class="btn" href="{{ f1.ticket }}" rel="noopener">{{ L.tickets }}</a>{% endif %}
      <a class="btn ghost" href="{{ fhref }}">{{ L.work_page }}</a></p>
      {% if f1.eventim %}<div class="ticket" id="t-feat" hidden></div>{% endif %}
    </div>
  </div>
</section>
{%- endif %}


<section class="section soon">
  <div class="wrap">
    <div class="section-head"><h2>{{ L.soon }}<span class="pt">.</span></h2></div>
    <ul class="soon-list">
      {%- for s in graph.soon %}
      <li><p class="kicker">{{ graph.venues[s.venue].name }}{% if s.by %} · {{ s.by }}{% endif %}</p>
        <h3>{{ s.title }}<span class="pt">.</span></h3><p class="soon-form">{{ s.form | t(lang) }}</p><p>{{ s.text | t(lang) }}</p></li>
      {%- endfor %}
    </ul>
  </div>
</section>

{%- set c = graph.courses[0] %}
<section class="section edu-teaser">
  <div class="wrap cols">
    <div>
      <p class="badge">{{ i18n[lang].register_open }}</p><h2 class="h-big">{{ c.title | t(lang) }}<span class="pt">.</span></h2>
      <p class="prose">{{ pages.edu[lang].lead }}</p>
    </div>
    <dl class="facts">
      <dt>{{ L.when }}</dt><dd>{{ c.when | t(lang) }}</dd>
      <dt>{{ L.where }}</dt><dd>{% set cv = graph.venues[c.venue] %}{% if cv.address %}<a class="vlink" href="{{ c.venue | venueHref(lang) }}">{{ cv.name }}</a>{% else %}{{ cv.name }}{% endif %}, {{ cv.address }}</dd>
      <dt>{{ L.fee }}</dt><dd>{{ c.fee | t(lang) }}</dd>
      <dt>{{ L.info }}</dt><dd>{{ c.lang | t(lang) }} · {{ c.level | t(lang) }}</dd>
      </dl><p style="margin-top:1.2rem"><a class="btn red" href="{{ c.form }}" rel="noopener">{{ L.register }}</a>{% if c.detail and lang == "tr" %} <a class="btn ghost" href="{{ ('/tr/tiyatro-pedagojisi/' + c.slug + '/') | url }}">Ayrıntılı bilgi</a>{% endif %}</p><dl hidden>
    </dl>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head"><h2>{{ L.archive }}<span class="pt">.</span></h2><a href="{{ ('/' + lang + '/' + S.works[lang] + '/') | url }}">{{ L.all_works }}</a></div>
    <div class="years" style="--n:{{ graph.yearList | length }}">
      {%- for y in graph.yearList %}
      <div class="year"><h3>{{ y.year }}<span class="pt">.</span></h3><ul>{% for w in y.works %}<li><a href="{{ ('/' + lang + '/' + S.works[lang] + '/' + w.slug + '/') | url }}">{{ w.title }}</a></li>{% endfor %}</ul></div>
      {%- endfor %}
    </div>
  </div>
</section>

