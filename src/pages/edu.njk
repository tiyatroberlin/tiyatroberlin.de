---
pagination: {data: site.langs, size: 1, alias: lang}
permalink: "/{{ lang }}/{{ site.sections.edu[lang] }}/"
layout: base.njk
section: edu
eleventyComputed:
  title: "{{ pages.edu[lang].title }}"
  alt: {tr: "/tr/tiyatro-pedagojisi/", de: "/de/theaterpaedagogik/", en: "/en/education/"}
---
{%- set P = pages.edu[lang] -%}
{%- set L = i18n[lang] -%}
<section class="page-head"><div class="wrap"><h1 class="h-huge">{{ P.title }}<span class="pt">.</span></h1><p class="lede big">{{ P.lead }}</p></div></section>
<section class="section"><div class="wrap cols">
  <div class="prose">{{ P.body | paras | safe }}</div>
  <figure class="poster"><img src="{{ '/assets/img/oyun/atolye.jpg' | url }}?v={{ build }}" alt="" loading="lazy" width="1000" height="556"></figure>
</div></section>
{%- for c in graph.courses %}
<section class="section"><div class="wrap cols">
  <div>
    <h2 class="h-big">{% if c.detail and lang == "tr" %}<a href="{{ ('/tr/tiyatro-pedagojisi/' + c.slug + '/') | url }}">{{ c.title | t(lang) }}</a>{% else %}{{ c.title | t(lang) }}{% endif %}<span class="pt">.</span></h2>
    {% if c.detail and lang == "tr" %}<p class="course-more"><a class="btn red" href="{{ ('/tr/tiyatro-pedagojisi/' + c.slug + '/') | url }}">Ayrıntılı bilgi</a></p>{% endif %}
    {% if c.text %}<div class="prose">{{ c.text | t(lang) | paras | safe }}</div>{% endif %}
    {% if c.topics %}<p class="prose">{{ c.topics | t(lang) }}</p>{% endif %}
  </div>
  <dl class="facts">
    <dt>{{ L.when }}</dt><dd>{{ c.when | t(lang) }}</dd>
    {% if c.where %}<dt>{{ L.where }}</dt><dd>{{ c.where | t(lang) }}</dd>{% endif %}{% if c.venue %}<dt>{{ L.where }}</dt><dd>{% set cv = graph.venues[c.venue] %}{% if cv.address %}<a class="vlink" href="{{ c.venue | venueHref(lang) }}">{{ cv.name }}</a>{% else %}{{ cv.name }}{% endif %}, {{ cv.address }}</dd>{% endif %}
    {% if c.fee %}<dt>{{ L.fee }}</dt><dd>{{ c.fee | t(lang) }}</dd>{% endif %}
    <dt>{{ L.info }}</dt><dd>{{ c.level | t(lang) }}{% if c.lang %} · {{ c.lang | t(lang) }}{% endif %}</dd>
    <dt>{{ L.teachers if c.teachers.length > 1 else L.teacher_one }}</dt><dd>{% for t in c.teachers %}<a href="{{ ('/' + lang + '/' + site.sections.people[lang] + '/' + t + '/') | url }}">{{ graph.people[t].name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
    {% if c.form %}</dl><p style="margin-top:1.2rem"><a class="btn red" href="{{ c.form }}" rel="noopener">{{ L.register }}</a>{% if c.detail and lang == "tr" %} <a class="btn ghost" href="{{ ('/tr/tiyatro-pedagojisi/' + c.slug + '/') | url }}">Ayrıntılı bilgi</a>{% endif %}</p><dl hidden>{% endif %}
  </dl>
</div></section>
{%- endfor %}
